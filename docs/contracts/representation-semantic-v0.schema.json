{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avelune.invalid/contracts/representation-semantic-v0.schema.json",
  "title": "Avelune Representation Semantic Envelope v0",
  "description": "Enveloppe expérimentale versionnée pour des données de représentation explicitement autorisées.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "projection_profile",
    "source",
    "frame",
    "descriptors",
    "events"
  ],
  "properties": {
    "contract_id": {
      "const": "avelune.representation.semantic"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "projection_profile": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_id", "source_version", "adapter_version"],
      "properties": {
        "kind": {
          "enum": ["synthetic", "replay", "live"]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "replay_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "sequence", "logical_time", "mode", "scope"],
      "properties": {
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "logical_time": {
          "type": "number",
          "minimum": 0
        },
        "mode": {
          "enum": ["full", "delta"]
        },
        "base_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": {
              "enum": ["world", "region", "scene"]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "delta"
              }
            }
          },
          "then": {
            "required": ["base_sequence"]
          }
        }
      ]
    },
    "descriptors": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{2,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/descriptor"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{2,63}$"
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "trend": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "type"],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$"
        },
        "phase": {
          "enum": ["start", "active", "end"]
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}